; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ChikagoShop"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[autoload]

GameLocalization="*res://scripts/Localization/GameLocalization.cs"
MonochromePresentation="*res://scripts/Presentation/MonochromePresentation.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="ChikagoShop"

[gui]

theme/custom="res://themes/game_theme.tres"

[internationalization]

locale/fallback="ru"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
