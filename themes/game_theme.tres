content_margin_right = 5.0
content_margin_top = 12.0
content_margin_bottom = 12.0

[resource]
default_font = ExtResource("1_font")
default_font_size = 20
VScrollBar/styles/scroll = SubResource("VScrollTrack")
VScrollBar/styles/grabber = SubResource("VScrollThumb")
VScrollBar/styles/grabber_highlight = SubResource("VScrollThumb")
