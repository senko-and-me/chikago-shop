[gd_resource type="Theme" load_steps=10 format=3]

[ext_resource type="FontFile" path="res://art/fonts/game.ttf" id="1_font"]
[ext_resource type="Texture2D" path="res://art/ui/scrollbar_track.png" id="2_vtrack"]
[ext_resource type="Texture2D" path="res://art/ui/scrollbar_grabber.png" id="3_vthumb"]
[ext_resource type="Texture2D" path="res://art/ui/scrollbar_track_horizontal.png" id="4_htrack"]
[ext_resource type="Texture2D" path="res://art/ui/scrollbar_grabber_horizontal.png" id="5_hthumb"]


[sub_resource type="StyleBoxTexture" id="VScrollTrack"]
texture = ExtResource("2_vtrack")
content_margin_left = 10.0
content_margin_right = 10.0

[sub_resource type="StyleBoxTexture" id="VScrollThumb"]
texture = ExtResource("3_vthumb")
content_margin_left = 12.0
content_margin_right = 12.0
content_margin_top = 5.0
content_margin_bottom = 5.0

[sub_resource type="StyleBoxTexture" id="HScrollTrack"]
texture = ExtResource("4_htrack")
