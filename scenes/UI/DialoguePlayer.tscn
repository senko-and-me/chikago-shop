[sub_resource type="ShaderMaterial" id="FrankieTone"]
resource_local_to_scene = true
shader = ExtResource("8_portrait")
shader_parameter/lighten = 0.32

[sub_resource type="ShaderMaterial" id="CastelloTone"]
resource_local_to_scene = true
shader = ExtResource("8_portrait")
shader_parameter/lighten = 0.32

[sub_resource type="ShaderMaterial" id="CustomerTone"]
resource_local_to_scene = true
shader = ExtResource("8_portrait")
shader_parameter/lighten = 0.0

[sub_resource type="Shader" id="CloudEdgeShader"]
code = "shader_type canvas_item;
void fragment() {
    vec4 cloud = COLOR;
    vec2 edge = min(UV, vec2(1.0) - UV);
    cloud.a *= smoothstep(0.0, 0.055, edge.x) * smoothstep(0.0, 0.10, edge.y);
    COLOR = cloud;
}"

[sub_resource type="ShaderMaterial" id="CloudEdge"]
shader = SubResource("CloudEdgeShader")

