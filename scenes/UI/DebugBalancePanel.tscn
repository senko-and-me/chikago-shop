[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/Debug/DebugBalancePanel.cs" id="1_script"]
[ext_resource type="Texture2D" path="res://art/ui/panel_large.png" id="2_paper"]
[ext_resource type="Texture2D" path="res://art/ui/panel_small.png" id="3_button"]

[sub_resource type="StyleBoxTexture" id="Paper"]
texture = ExtResource("2_paper")
content_margin_left = 50.0
content_margin_top = 34.0
content_margin_right = 50.0
content_margin_bottom = 34.0

[sub_resource type="StyleBoxFlat" id="Form"]
