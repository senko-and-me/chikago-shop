content_margin_right = 10.0

[sub_resource type="StyleBoxTexture" id="ButtonPaper"]
texture = ExtResource("3_button")
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0

[sub_resource type="Theme" id="FormTheme"]
Button/colors/font_color = Color(0.1, 0.1, 0.1, 1)
Button/colors/font_hover_color = Color(0.1, 0.1, 0.1, 1)
Button/colors/font_pressed_color = Color(0.1, 0.1, 0.1, 1)
Button/colors/font_focus_color = Color(0.1, 0.1, 0.1, 1)
Button/colors/font_hover_pressed_color = Color(0.1, 0.1, 0.1, 1)
Button/styles/normal = SubResource("ButtonPaper")
Button/styles/hover = SubResource("ButtonPaper")
Button/styles/pressed = SubResource("ButtonPaper")
LineEdit/colors/font_color = Color(0.1, 0.1, 0.1, 1)
LineEdit/colors/caret_color = Color(0.1, 0.1, 0.1, 1)
LineEdit/styles/normal = SubResource("Input")
TabContainer/styles/panel = SubResource("Form")

[node name="DebugBalancePanel" type="CanvasLayer"]
process_mode = 3
layer = 300
script = ExtResource("1_script")

[node name="Root" type="Control" parent="."]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Shade" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.8)

[node name="Inset" type="MarginContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 18

[node name="Panel" type="PanelContainer" parent="Root/Inset"]
layout_mode = 2
theme_override_styles/panel = SubResource("Paper")
theme = SubResource("FormTheme")

[node name="Content" type="VBoxContainer" parent="Root/Inset/Panel"]
layout_mode = 2
