&"Остался {0} день, включая сегодня": &"{0} day left, including today",
&"Осталось {0} дня, включая сегодня": &"{0} days left, including today",
&"Осталось {0} дней, включая сегодня": &"{0} days left, including today",
&"Магазин закрыт": &"Shop is closed",
&"Середина дня": &"Midday",
&"НАСТРОЙКИ": &"SETTINGS",
&"Полный экран": &"Fullscreen",
