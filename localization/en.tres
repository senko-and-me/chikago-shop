&"АТЕЛЬЕ": &"ATELIER",
&"МУЗ. ШТУКИ": &"MUSIC WORKSHOP",
&"ВИТРИНЫ": &"SHOWCASES",
&"ТОРГОВЫЙ ЗАЛ": &"TRADING ROOM",
&"Шляпа или перчатки  •  90$ за 3": &"Hat or gloves  •  3 for $90",
&"Гитара или труба  •  110$ за 3": &"Guitar or trumpet  •  3 for $110",
&"Гитара или труба  •  140$ за 3": &"Guitar or trumpet  •  3 for $140",
&"3 предмета  •  90$": &"3 items  •  $90",
&"3 предмета  •  110$": &"3 items  •  $110",
&"3 предмета  •  140$": &"3 items  •  $140",
&"Выберите предмет в инвентаре и свободную витрину": &"Select an inventory item and an empty showcase",
&"КОМНАТА ЗАКРЫТА": &"ROOM LOCKED",
&"ОТКРЫТЬ ЗА 100$": &"UNLOCK FOR $100",
&"Открыть музыкальную комнату за 100$": &"Unlock the music workshop for $100",
&"СВОБОДНО": &"EMPTY",
&"шляпка-клош": &"cloche hat",
&"перчатки": &"gloves",
&"гитара": &"guitar",
